# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # 仅服务端使用

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL=wss://xxxx.livekit.cloud   # 客户端连接用（wss）
LIVEKIT_API_KEY=APIxxxx
LIVEKIT_API_SECRET=xxxx                    # 仅服务端使用

# Resend (用于 Supabase Auth OTP 邮件)
# 在 Supabase Dashboard → Auth → Settings → SMTP 配置：
# Host: smtp.resend.com
# Port: 465
# Username: resend
# Password: <your Resend API key (re_...)>
# Sender email: noreply@<your-resend-domain>

# === v2 新增 ===

# AI Provider (PRD §6.9)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...                    # 仅服务端；未配置时审核降级放行

# Stripe（未来可选；不属于当前发布门槛）
# 仅在明确启用订阅/商业化时配置以下变量。
STRIPE_SECRET_KEY=sk_live_...            # 仅服务端，可选
STRIPE_WEBHOOK_SECRET=whsec_...          # 仅服务端，可选
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...  # 可选
STRIPE_PRICE_PRO_MONTHLY=price_...       # 可选

# Web Push (VAPID) (PRD §6.12)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...

# 可观测性 (PRD §12)
SENTRY_DSN=                              # 可选
NEXT_PUBLIC_POSTHOG_KEY=                 # 可选
NEXT_PUBLIC_POSTHOG_HOST=                # 可选

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # 仅服务端使用

# LiveKit
NEXT_PUBLIC_LIVEKIT_URL=wss://xxxx.livekit.cloud   # 客户端连接用（wss）
LIVEKIT_API_KEY=APIxxxx
LIVEKIT_API_SECRET=xxxx                    # 仅服务端使用

# Resend (用于 Supabase Auth OTP 邮件)
# 在 Supabase Dashboard → Auth → Settings → SMTP 配置：
# Host: smtp.resend.com
# Port: 465
# Username: resend
# Password: <your Resend API key (re_...)>
# Sender email: noreply@<your-resend-domain>
